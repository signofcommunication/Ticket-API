@Ticket_API_HostAddress = http://localhost:5006

# Login (demo: admin@helpdesk.test / password)
POST {{Ticket_API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@helpdesk.test",
  "password": "password"
}

###

# Dashboard (ganti TOKEN dengan JWT dari login)
GET {{Ticket_API_HostAddress}}/api/dashboard
Authorization: Bearer TOKEN

###

# OpenAPI document (dipakai Scalar)
GET {{Ticket_API_HostAddress}}/openapi/v1.json
Accept: application/json

###
